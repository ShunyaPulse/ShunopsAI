# ========================================================
# Agent API Server Configuration
# ========================================================
PORT=4000
# Bind address. Keep 127.0.0.1 unless running behind an authenticated proxy.
HOST=127.0.0.1
# Bearer token required by privileged endpoints (/api/task, /api/approve, ...).
# REQUIRED before binding to a public interface (HOST=0.0.0.0).
AGENT_API_TOKEN=
# Comma-separated allowed CORS origins. Leave EMPTY to deny all cross-origin
# requests (recommended). Do not use '*' with credentials.
CORS_ORIGINS=http://localhost:4000
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW=60000
# Dashboard Web UI (HTTP Basic Auth). Required when AGENT_API_TOKEN is unset.
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=
# Absolute public base URL of this server (used to build the embeddable widget
# and webhook URLs). Set this when running behind a proxy to avoid trusting the
# Host header.
PUBLIC_BASE_URL=
# Set to true only when running behind a trusted reverse proxy.
TRUST_PROXY=false
# Shared secret for POST /api/webhook/cloud-alert (falls back to API_SECRET).
# Send it as the X-Webhook-Secret header or an Authorization: Bearer token.
WEBHOOK_SECRET=
# Secret used to sign action-confirmation tokens (Cloudflare Worker edge app).
# Generate with: openssl rand -hex 32
ACTION_SECRET=

# ========================================================
# AI Brain — REQUIRED (at least one provider)
# ========================================================
# OpenRouter (primary agent + fallback chain)
OPENROUTER_API_KEY=
# Groq (fast fallback + video script fallback + Whisper)
GROQ_API_KEY=
# Gemini key pool: comma-separated keys, e.g. key1,key2,key3
GEMINI_API_KEY=
# Optional preferred Gemini model for video scripting
GEMINI_MODEL=

# ========================================================
# Neon Serverless Postgres (Optional)
# postgresql://user:password@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require
# ========================================================
DATABASE_URL=
NEON_DATABASE_URL=

# ========================================================
# Redis Cache (Optional)
# redis://default:password@host:6379
# ========================================================
REDIS_URL=
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=

# ========================================================
# GitHub (Optional)
# ========================================================
GITHUB_PAT=
GITHUB_TOKEN=
# Secret used to verify x-hub-signature-256 on /api/github-webhook.
# REQUIRED: the endpoint refuses unsigned webhooks when this is not set.
GITHUB_WEBHOOK_SECRET=
# Webhook endpoints for the GCP notification-channel wiring tool.
N8N_WEBHOOK_URL=
SHUNOPS_BASE_URL=
# Comma-separated target repos for autonomous auditing and self-healing
AUTONOMOUS_TARGET_REPOS=ShunyaPulse/ShunopsAI,ShunyaPulse/saralgati

# ========================================================
# Google Cloud (Optional)
# ========================================================
GCP_PROJECT_ID=
GCP_DEFAULT_REGION=
GCP_SA_KEY_PATH=

# ========================================================
# Kaggle Video Pipeline (Optional)
# ========================================================
KAGGLE_USERNAME=
KAGGLE_API_TOKEN=
# Hugging Face token (private/rate-limited diffusion models)
HF_TOKEN=

# ========================================================
# Telegram Remote Approvals (Optional)
# ========================================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
