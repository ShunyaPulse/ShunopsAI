{
  "name": "shunopsai",
  "version": "1.0.0",
  "type": "module",
  "description": "ShunopsAI: Autonomous Multi-Cloud & DevOps Sentinel Agent powered by OpenRouter, GitHub Actions, and n8n",
  "main": "agent.ts",
  "scripts": {
    "start": "tsx agent.ts",
    "server": "tsx server.ts",
    "test": "tsx test-tools.ts",
    "typecheck": "tsc --noEmit",
    "resolve-alerts": "tsx src/tools/code-scanner-resolver.ts",
    "worker:dev": "wrangler dev",
    "worker:deploy": "wrangler deploy"
  },
  "keywords": [
    "agent",
    "react",
    "nemotron",
    "openrouter",
    "autonomous"
  ],
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/swagger": "^9.9.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@neondatabase/serverless": "^1.2.0",
    "@sinclair/typebox": "^0.34.52",
    "@types/ioredis": "^5.0.0",
    "dotenv": "^18.0.5",
    "fastify": "^5.12.5",
    "fastify-raw-body": "^6.0.1",
    "hono": "^4.13.13",
    "ioredis": "^6.0.0",
    "nodemailer": "^10.0.14",
    "openai": "^7.27.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261005.1",
    "@types/node": "^26.6.4",
    "@types/nodemailer": "^8.0.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
