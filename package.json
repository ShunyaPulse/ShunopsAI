{
  "name": "shunopsai",
  "version": "1.0.0",
  "type": "module",
  "description": "ShunopsAI: Autonomous Multi-Cloud & DevOps Sentinel Agent powered by OpenRouter, GitHub Actions, and n8n",
  "main": "agent.ts",
  "scripts": {
    "start": "tsx server.ts",
    "server": "tsx server.ts",
    "agent": "tsx agent.ts",
    "test": "tsx tests/production-suite.test.ts && tsx tests/multi-tenant-scope.test.ts",
    "test:isolation": "tsx tests/multi-tenant-scope.test.ts",
    "typecheck": "tsc --noEmit",
    "resolve-alerts": "tsx src/tools/code-scanner-resolver.ts",
    "worker:dev": "npx wrangler dev",
    "worker:deploy": "npx wrangler deploy"
  },
  "keywords": [
    "agent",
    "react",
    "nemotron",
    "openrouter",
    "autonomous"
  ],
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/cors": "^11.3.0",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/swagger": "^9.9.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@neondatabase/serverless": "^1.2.0",
    "@sinclair/typebox": "^0.34.52",
    "@types/ioredis": "^5.0.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.5",
    "fastify": "^5.12.5",
    "fastify-raw-body": "^6.0.1",
    "google-auth-library": "^11.2.0",
    "hono": "^4.13.13",
    "ioredis": "^6.0.0",
    "nodemailer": "^10.0.14",
    "openai": "^7.27.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261005.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^26.6.4",
    "@types/nodemailer": "^8.0.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
