        [
          {
            "node": "Respond to Webhook (Success)",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Inspect Pending Approvals",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Inspect Pending Approvals": {
      "main": [
        [
          {
            "node": "Respond (HITL Alert)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
